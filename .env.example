# Demo-only UI access code. Use a long unique value and never commit the real .env file.
VITE_STAFF_ACCESS_CODE=replace-with-a-private-demo-code

# Signs project-scoped, expiring client demo links.
# This improves the prototype flow but is not a substitute for server-side authorization.
VITE_CLIENT_LINK_SECRET=replace-with-a-long-random-demo-secret
